NODE_ENV=development
PORT=3011
CORS_ORIGIN=http://localhost:5183
FRONTEND_URL=http://localhost:5183

PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=cartera_aed_v2

JWT_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_BASE=https://www.zohoapis.com/crm/v2
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

EXCEL_PASSWORD=

# Proyecto Oliv (CRM HubSpot, ver utils/hubspotClient.js) -- token estático
# de Private App (Settings → Integrations → Private Apps en HubSpot), sin
# OAuth de por medio. HUBSPOT_API_BASE solo si no es el estándar.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_BASE=https://api.hubapi.com

# Solo para scripts/importarDatosLegado.js (import de solo lectura desde la
# base de zoho-payment-tracker/) -- mismo valor que DATABASE_URL en
# zoho-payment-tracker/backend/.env. No se usa en el arranque normal del
# servidor.
LEGACY_DATABASE_URL=

# Solo lectura -- base de datos de Centro-Aplicaciones-Comerciales-AED (el
# Cotizador de Cuotas), para traer el plan de pago de la cotización aceptada
# de un negocio de Oliv (tabla `quotes`, join por `deal_id` = hubspot_id).
# Mismo valor que DATABASE_URL en Centro-Aplicaciones-Comerciales-AED/.env.
CENTRO_APLICACIONES_DATABASE_URL=
